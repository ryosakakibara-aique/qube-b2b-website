# Copy to .env.local and fill in with the project's Supabase credentials.
# Never commit .env.local - only this example file belongs in Git.

# Public Supabase project URL (safe to expose to the browser).
# Use the project URL exactly as shown under Project Settings -> Data API -> Project URL, with no
# trailing path. The Data API URL (ending in /rest/v1/) looks almost identical but breaks every
# request, because the client appends its own paths to whatever it is given.
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anon/publishable key (safe to expose; access is governed by RLS).
# The new "sb_publishable_..." key and the legacy anon JWT both work here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public origin, without a trailing slash.
# Used for canonical URLs, Open Graph, JSON-LD and sitemap.xml.
# Production (Render): https://business.qubesmartlockers.com
# Local development:   http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Supabase Storage bucket holding CMS-uploaded product imagery.
# The bucket itself is created by supabase/migrations/002_*.sql.
NEXT_PUBLIC_SUPABASE_PRODUCT_IMAGE_BUCKET=

# Optional. Where to announce a new contact-form enquiry.
# Any endpoint that accepts a JSON POST works: a Microsoft Teams workflow, a Slack incoming
# webhook, or a Power Automate flow. Leave empty to store enquiries silently (they are always
# stored in contact_submissions and visible at /cms/inquiries).
# Server-only: never expose this as NEXT_PUBLIC.
INQUIRY_WEBHOOK_URL=
